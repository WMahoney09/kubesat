# KubeSAT Environment Variables
# Copy to .env and fill in real values: cp .env.example .env

# Anthropic API key for Claude Code (required)
ANTHROPIC_API_KEY=

# GitHub token — needs repo, workflow scopes for cloning, PRs, and merges (required)
GITHUB_TOKEN=

# GitHub repo URL the Actor clones and works against (mission-dependent)
TARGET_REPO=

# Orbit interval in seconds (default: 600 = 10 minutes)
ORBIT_INTERVAL=600

# --- Adapter configuration (optional) ---
# When set, the Dispatcher uses the adapter for delta detection.
# When unset, the Dispatcher dispatches an Actor every orbit unconditionally.

# Which adapter to use (e.g., github-issues)
# KUBESAT_ADAPTER=

# For the github-issues adapter: repo to poll (e.g., owner/repo)
# For the meta case, this is typically the same as TARGET_REPO.
# ADAPTER_REPO=
